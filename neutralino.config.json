{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.github.julienb1.hobos",
  "version": "0.3.0",
  "defaultMode": "window",
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "Project Hobos (demo)",
      "width": 1600,
      "height": 900,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "exitProcessOnClose": true,
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "hobos",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/tooling/.build/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "distributionPath": "/release"
  }
}
